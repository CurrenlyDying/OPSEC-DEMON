#!/usr/bin/env python3
"""
nemo — the POINT NEMO event engine.

  nemo daemon                  run every watcher (started by systemd: point-nemo.service)
  nemo emit EVENT [k=v ...]    fire an event (respects cooldown / mute)
  nemo test EVENT [k=v ...]    fire an event ignoring cooldown / mute
  nemo list                    every event: popup?, cooldown, custom sounds, quote count
  nemo mute [MINUTES]          silence everything (default 60 min)   |  nemo unmute
  nemo log                     follow the event log

Sound lookup:  sounds/<event>/*  ->  sounds/<family>/*  ->  sounds/_default/*
Quote lookup:  quotes/<event>.txt -> quotes/<family>.txt -> quotes/_chaos.txt
  (family = event name up to the first '-', e.g. git-push -> git, notif-signal -> notif)
Per-event switches: ~/.config/point-nemo/events.json  (popup / sound / cooldown / enabled)
"""
import fcntl, html, json, os, random, re, shutil, signal, socket, subprocess, sys, threading, time
