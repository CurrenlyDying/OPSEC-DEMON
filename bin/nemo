CONF = HOME / ".config/point-nemo/events.json"
RUN = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "point-nemo"
STATE, MUTE = RUN / "state.json", RUN / "mute-until"
LOG = HOME / ".local/state/point-nemo/events.log"
ICON = HOME / ".local/share/icons/magician-ghidra.png"
AUDIO = (".mp3", ".wav", ".ogg", ".oga", ".flac", ".opus")
DEVNULL = subprocess.DEVNULL

