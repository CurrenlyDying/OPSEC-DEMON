[Unit]
Description=POINT NEMO audio server (the "Point Nemo" slider in the mixer's Applications tab)
PartOf=graphical-session.target
After=pipewire.service pipewire-pulse.service wireplumber.service
Before=point-nemo.service

[Service]
ExecStart=%h/.local/bin/nemo-bus
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
